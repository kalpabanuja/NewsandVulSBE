<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ThreatIntelClient.ViewModels"
             x:Class="ThreatIntelClient.Views.SettingsPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="15">
            
            <!-- Storage & Sync -->
            <Label Text="Storage &amp; Sync" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#2B579A, Dark=#4B77BA}" />
            <Border Padding="10" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                        <Label Text="Wi-Fi Only Sync" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                        <Switch IsToggled="{Binding WifiOnlySync, Mode=TwoWay}" HorizontalOptions="End" />
                    </HorizontalStackLayout>
                    
                    <BoxView HeightRequest="1" Color="Gray" Opacity="0.2" />

                    <Label Text="Offline Database Duration (Years)" />
                    <Slider Minimum="1" Maximum="10" Value="{Binding OfflineRetentionYears, Mode=TwoWay}" />
                    <Label Text="{Binding OfflineRetentionYears, StringFormat='Keep data for {0:F0} years'}" HorizontalOptions="Center" FontSize="12" TextColor="Gray" />
                </VerticalStackLayout>
            </Border>

            <!-- Appearance -->
            <Label Text="Appearance" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#2B579A, Dark=#4B77BA}" Margin="0,10,0,0" />
            <Border Padding="10" StrokeShape="RoundRectangle 8">
                <HorizontalStackLayout HorizontalOptions="FillAndExpand">
                    <Label Text="Theme Mode" VerticalOptions="Center" HorizontalOptions="StartAndExpand" />
                    <Picker ItemsSource="{Binding Themes}" SelectedItem="{Binding ThemeMode, Mode=TwoWay}" HorizontalOptions="End" WidthRequest="150" />
                </HorizontalStackLayout>
            </Border>

            <!-- Database Status -->
            <Label Text="Database Status" FontAttributes="Bold" FontSize="18" TextColor="{AppThemeBinding Light=#2B579A, Dark=#4B77BA}" Margin="0,10,0,0" />
            <Border Padding="15" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding DatabaseMetrics}" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Button Text="Clear / Prune Local Cache" 
                            Command="{Binding PruneDatabaseCommand}" 
                            BackgroundColor="DarkRed" 
                            TextColor="White"
                            CornerRadius="8" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
