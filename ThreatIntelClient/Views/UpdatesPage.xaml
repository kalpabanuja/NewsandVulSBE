<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ThreatIntelClient.ViewModels"
             xmlns:models="clr-namespace:ThreatIntelClient.Models"
             xmlns:views="clr-namespace:ThreatIntelClient.Views"
             x:Class="ThreatIntelClient.Views.UpdatesPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <DataTemplate x:Key="CveTemplate" x:DataType="models:Cve">
            <Border Margin="10,5" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="#2D112B">
                <VerticalStackLayout>
                    <Label Text="🚨 NEW CVE" TextColor="Red" FontAttributes="Bold" FontSize="12" />
                    <Label Text="{Binding Id}" FontFamily="Consolas" FontAttributes="Bold" FontSize="16" />
                    <Label Text="{Binding Description}" MaxLines="2" LineBreakMode="TailTruncation" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="NewsTemplate" x:DataType="models:NewsArticle">
            <Border Margin="10,5" Padding="15" StrokeShape="RoundRectangle 8" BackgroundColor="#112B2D">
                <VerticalStackLayout>
                    <Label Text="📰 BREAKING NEWS" TextColor="Aqua" FontAttributes="Bold" FontSize="12" />
                    <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                </VerticalStackLayout>
            </Border>
        </DataTemplate>

        <views:FeedTemplateSelector x:Key="FeedSelector"
                                    CveTemplate="{StaticResource CveTemplate}"
                                    NewsTemplate="{StaticResource NewsTemplate}" />
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">
        <!-- Status Banner -->
        <Border Grid.Row="0" BackgroundColor="{Binding StatusColor}" Padding="10" StrokeThickness="0">
            <Label Text="{Binding ConnectionStatus}" TextColor="White" HorizontalOptions="Center" FontAttributes="Bold" />
        </Border>

        <!-- Live Feed -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding LiveFeed}"
                        ItemTemplate="{StaticResource FeedSelector}" />
    </Grid>
</ContentPage>
