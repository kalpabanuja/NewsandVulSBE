<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ThreatIntelClient.ViewModels"
             xmlns:models="clr-namespace:ThreatIntelClient.Models"
             xmlns:converters="clr-namespace:ThreatIntelClient.Converters"
             x:Class="ThreatIntelClient.Views.VulnerabilitiesPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:CvssToColorConverter x:Key="CvssColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Search Bar -->
        <SearchBar Grid.Row="0" 
                   Placeholder="Search CVEs..." 
                   Text="{Binding SearchQuery, Mode=TwoWay}" />

        <!-- Filters -->
        <HorizontalStackLayout Grid.Row="1" Padding="10,5" Spacing="10" VerticalOptions="Center">
            <Label Text="Severity:" VerticalOptions="Center" FontAttributes="Bold" />
            <Picker ItemsSource="{Binding Severities}" 
                    SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                    HorizontalOptions="FillAndExpand" />
        </HorizontalStackLayout>

        <!-- List -->
        <CollectionView Grid.Row="2" 
                        ItemsSource="{Binding Cves}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        SelectionMode="Single"
                        SelectionChanged="OnCveSelected">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Cve">
                    <Border Margin="10,5" Padding="15" StrokeShape="RoundRectangle 8">
                        <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto">
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Id}" FontFamily="Consolas" FontAttributes="Bold" FontSize="16" />
                            <Border Grid.Row="0" Grid.Column="1" BackgroundColor="{Binding CvssScore, Converter={StaticResource CvssColorConverter}}" Padding="8,4" StrokeShape="RoundRectangle 12">
                                <Label Text="{Binding CvssScore, StringFormat='{0:F1}'}" TextColor="White" FontAttributes="Bold" />
                            </Border>
                            <Label Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Description}" MaxLines="3" LineBreakMode="TailTruncation" Margin="0,5,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
