<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ThreatIntelClient.ViewModels"
             xmlns:models="clr-namespace:ThreatIntelClient.Models"
             x:Class="ThreatIntelClient.Views.NewsPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *">
        <!-- Search Bar -->
        <SearchBar Grid.Row="0" 
                   Placeholder="Search News..." 
                   Text="{Binding SearchQuery, Mode=TwoWay}" />

        <!-- List -->
        <CollectionView Grid.Row="1" 
                        ItemsSource="{Binding Articles}"
                        RemainingItemsThreshold="5"
                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NewsArticle">
                    <ContentView Padding="10,5">
                        <Border Padding="0" StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1E1E1E}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:NewsViewModel}}, Path=OpenArticleCommand}"
                                    CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="100, *" RowDefinitions="Auto,Auto,Auto">
                                <!-- Thumbnail -->
                                <Image Grid.RowSpan="3" Grid.Column="0" 
                                       Source="{Binding ThumbnailUrl}" 
                                       Aspect="AspectFill" 
                                       HeightRequest="100" 
                                       WidthRequest="100" />
                                
                                <!-- Title -->
                                <Label Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding Title}" 
                                       FontAttributes="Bold" 
                                       FontSize="16" 
                                       MaxLines="2" 
                                       LineBreakMode="TailTruncation"
                                       Margin="10,10,10,0" />
                                
                                <!-- Source Pill -->
                                <Border Grid.Row="1" Grid.Column="1" 
                                        HorizontalOptions="Start"
                                        BackgroundColor="#2B579A" 
                                        Padding="6,2" 
                                        StrokeShape="RoundRectangle 10" 
                                        Margin="10,5,10,0">
                                    <Label Text="{Binding Source}" TextColor="White" FontSize="12" />
                                </Border>
                                
                                <!-- TimeAgo -->
                                <Label Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding PublishedDate, StringFormat='{0:MMM dd, yyyy}'}" 
                                       FontSize="12" 
                                       TextColor="Gray"
                                       Margin="10,5,10,10" />
                            </Grid>
                        </Border>
                    </ContentView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
